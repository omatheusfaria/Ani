@startuml estados-jogo
!pragma layout smetana
title Diagrama de Estados – classe Jogo (estadoAtual : EstadoJogo)

state "Menu" as Menu
state "Jogando" as Jogando
state "Pausado" as Pausado
state "Crise" as Crise : crise de ansiedade (RF018)
state "Encerrado" as Encerrado

[*] --> Menu
Menu --> Jogando : novo jogo (UC-S014) / iniciar()
Menu --> Jogando : continuar (UC-S013) / carregarProgresso()
Jogando --> Pausado : comando de pausa (UC-S006) / pausar()
Pausado --> Jogando : retomar (UC-S006, 3a) / retomar()
Jogando --> Crise : início da crise (RF018) *
Crise --> Jogando : fim da crise (RF018) *
Pausado --> Encerrado : saída confirmada (UC-S011) / encerrar()
Encerrado --> [*]

legend bottom
  ~* Transição sem método correspondente no diagrama de classes.
endlegend
@enduml
