@startuml sequencia-salvar-continuar
title Diagrama de Sequência – Salvar e continuar jogo (UC-S012 / UC-S013)

actor Jogador
participant ":Jogo" as Jogo
participant ":Save" as Save
participant ":Diario" as Diario
participant ":Cenario" as Cen

== Salvar jogo (UC-S012) ==
Jogador -> Jogo : comando de salvar
activate Jogo
Jogo -> Jogo : salvarProgresso()
note right of Jogo
  Coleta o ato em curso (atoAtual),
  o estado do diário (via Ani) e o estado
  visual da casa (cenarioAtual).
end note
Jogo -> Save : salvar()
activate Save
Save --> Jogo : gravação concluída ou erro
deactivate Save
alt gravação concluída
  Jogo --> Jogador : progresso salvo
else erro na gravação
  Jogo --> Jogador : notificação de erro
end
deactivate Jogo

== Continuar jogo (UC-S013) ==
Jogador -> Jogo : comando de continuar
activate Jogo
Jogo -> Jogo : carregarProgresso()
Jogo -> Save : carregar()
activate Save
Save --> Jogo : estado salvo ou erro de leitura
deactivate Save
alt leitura bem-sucedida
  note over Jogo : Restaura o ato em curso (atoAtual).
  Jogo -> Diario : restaurar()
  note right of Diario : Alcançado por meio de Ani\n(associação Jogo ↔ Ani).\nRepõe as entradas e as\nmemórias registradas.
  Jogo -> Cen : restaurarEstado()
  note right of Cen : Repõe o estado\nvisual da casa.
  Jogo -> Cen : carregarCenario()
  Jogo --> Jogador : controle devolvido no ponto salvo
else falha na leitura
  Jogo --> Jogador : notificação e retorno ao menu inicial
end
deactivate Jogo
@enduml
